# WhatsApp Business number in international format, no "+" or leading zero.
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# Webhook URL that receives checkout order submissions as JSON POST requests
# (e.g. a Zapier/Make/Google Sheets webhook, or your own serverless function).
# Leave unset during development to see the fallback error on checkout.
NEXT_PUBLIC_ORDER_WEBHOOK_URL=

# M-Pesa Till Number (Buy Goods and Services) shown on the checkout page.
NEXT_PUBLIC_MPESA_TILL=000000

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable analytics.
NEXT_PUBLIC_GA4_ID=
# Optional second GA4 property — every visit is reported to both. Leave unset to use only the one above.
NEXT_PUBLIC_GA4_ID_2=

# Supabase project (customer accounts, loyalty points, product catalog +
# admin panel). See docs/SUPABASE_SETUP.md.
# Leave both unset to keep account/admin pages showing a graceful "coming
# soon" state, and the site falling back to data/*.json for the catalog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel/Netlify deploy hook — triggers a rebuild whenever a product is
# created/edited/deleted in /admin, so the change goes live. See
# docs/SUPABASE_SETUP.md step 8. Leave unset to save without auto-rebuilding.
NEXT_PUBLIC_DEPLOY_HOOK_URL=

# Set to "true" ONLY after the PayHero Edge Functions are deployed
# (docs/PAYHERO_SETUP.md). Until then checkout skips the automatic M-Pesa
# prompt and goes straight to paying the Till and confirming the M-Pesa code.
NEXT_PUBLIC_MPESA_PROMPT_ENABLED=
